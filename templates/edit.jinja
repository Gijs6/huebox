{% extends "base.jinja" %}

{% block title %}{{ palette.name if palette else "New palette" }}{% endblock %}

{% block extra_headers %}
    <script src="{{ url_for('static', filename='scripts/copy-text.js') }}" defer></script>
    <script src="{{ url_for('static', filename='scripts/editor.js') }}" defer></script>
{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>
            {% if palette %}
                Edit palette
            {% else %}
                New palette
            {% endif %}
        </h1>
    </div>

    <form class="editor"
          id="paletteEditor"
          method="post"
          {% if palette %}hx-put="{{ url_for('submit_palette', id=palette.id) }}"{% else %}action="{{ url_for('submit_new') }}"{% endif %}>
        <div class="field">
            <label class="field__label" for="paletteName">Name</label>
            <input type="text"
                   class="editor__name"
                   id="paletteName"
                   name="name"
                   placeholder="Palette name"
                   {% if palette %}value="{{ palette.name }}"{% endif %}
                   required />
        </div>

        <div class="field editor__visibility">
            <label class="checkbox">
                <input type="checkbox"
                       name="is_public"
                       id="isPublic"
                       {% if palette and palette.is_public %}checked{% endif %} />
                Public palette
            </label>
            <span class="field__hint" id="visibilityHint"></span>
        </div>

        <p class="field__label">Colours</p>
        <ul class="color-slot-list" id="colorList">
            {% if palette %}
                {% for color in palette.colors %}
                    <li class="color-slot"
                        style="--color: {{ color.hex_value }}"
                        draggable="true">
                        <span class="color-slot__swatch">
                            <input type="hidden"
                                   class="color-slot__input"
                                   name="colors"
                                   value="{{ color.hex_value }}" />
                            <button type="button" class="color-slot__remove" aria-label="Remove colour">&times;</button>
                        </span>
                        <button type="button" class="color-slot__hex" aria-label="Copy hex value">{{ color.hex_value }}</button>
                    </li>
                {% endfor %}
            {% endif %}
        </ul>
    </form>

    <div class="form__actions editor__actions">
        <button type="button" class="btn" id="addColorButton">Add colour</button>
        <button type="submit" form="paletteEditor" class="btn">Save palette</button>
        <button type="button" class="btn" id="contrastButton">Contrast</button>
        {% if palette %}
            <button type="button" class="btn" id="copyCssButton">Copy CSS</button>
            <button type="button" class="btn" id="copyJsonButton">Copy JSON</button>
            <button type="button"
                    class="btn"
                    hx-post="{{ url_for('duplicate_palette', id=palette.id) }}"
                    hx-swap="none">Duplicate</button>
            {% if palette.is_public %}
                <a href="{{ url_for('view_palette', id=palette.id) }}"
                   class="btn"
                   target="_blank"
                   rel="noopener">View</a>
            {% endif %}
            <button type="button"
                    class="btn btn--danger"
                    hx-delete="{{ url_for('delete_palette', id=palette.id) }}"
                    hx-confirm="Delete {{ palette.name }}?"
                    hx-swap="none">Delete palette</button>
        {% endif %}
    </div>

    <section class="panel contrast-panel" id="contrastPanel" hidden>
        <h2 class="panel__heading">Contrast</h2>
        <div class="table-wrap" id="contrastInner"></div>
    </section>

    {# djlint:off #}
    <script>
        const isNewPalette = {{ (not palette) | tojson }};
    </script>
    {# djlint:on #}
{% endblock %}
