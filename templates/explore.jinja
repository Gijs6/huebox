{% extends "base.jinja" %}

{% from "_macros.jinja" import swatches, color_count, owner %}

{% block title %}Explore{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Explore</h1>
    </div>

    {% if palettes %}
        <section class="panel">
            <h2 class="panel__heading">
                <span>Public palettes <span class="count">{{ "{:,}".format(palettes | length) }}</span></span>
            </h2>
            <ul class="palette-grid">
                {% for palette in palettes %}
                    <li class="palette-card">
                        <a class="palette-card__preview"
                           href="{{ url_for('view_palette', id=palette.id) }}"
                           tabindex="-1"
                           aria-hidden="true">{{ swatches(palette.colors) }}</a>
                        <div class="palette-card__body">
                            <a class="palette-card__name"
                               href="{{ url_for('view_palette', id=palette.id) }}">{{ palette.name }}</a>
                            <p class="palette-card__meta">
                                {{ owner(palette.owner) }}, {{ color_count(palette.colors) }}
                                {%- if not (current_user and current_user.id != palette.user_id) %}, {{ palette.like_count }} like{{ 's' if palette.like_count != 1 }}{% endif %}
                            </p>
                            {% if current_user and current_user.id != palette.user_id %}
                                <div class="form__actions">
                                    {% with liked = palette.id in liked_ids, small = true %}
                                        {% include "_like_button.jinja" %}
                                    {% endwith %}
                                    <button type="button"
                                            class="btn btn--sm"
                                            hx-post="{{ url_for('fork_palette', id=palette.id) }}"
                                            hx-swap="none">Fork</button>
                                </div>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <div class="empty">
            <p class="empty__title">No public palettes yet</p>
        </div>
    {% endif %}
{% endblock %}
