{% macro swatches(colors) -%}
    <span class="swatch-strip">
        {% for color in colors -%}<span class="swatch-strip__cell" style="--color: {{ color.hex_value }}"></span>{%- endfor %}
    </span>
{%- endmacro %}

{% macro color_count(colors) -%}
    {{ colors | length }} colour{{ 's' if colors | length != 1 }}
{%- endmacro %}

{% macro owner(user) -%}
    <span class="owner">
        {% if user.avatar_url %}<img src="{{ user.avatar_url }}" alt="" class="avatar" />{% endif %}
        {{ user.login }}
    </span>
{%- endmacro %}
