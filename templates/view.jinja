{% extends "base.jinja" %}

{% from "_macros.jinja" import color_count, owner %}

{% block title %}{{ palette.name }}{% endblock %}

{% block extra_headers %}
    <script src="{{ url_for('static', filename='scripts/copy-text.js') }}" defer></script>
    <script src="{{ url_for('static', filename='scripts/view.js') }}" defer></script>
{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>
                {{ palette.name }}
                {% if palette.is_public %}
                    <span class="status status--ok">(public)</span>
                {% else %}
                    <span class="status">(private)</span>
                {% endif %}
            </h1>
        </div>
    </div>

    <div class="table-wrap">
        <table class="table table--kv table--fit">
            <caption class="visually-hidden">Details</caption>
            <tbody>
                <tr>
                    <th scope="row">Owner</th>
                    <td>{{ owner(palette.owner) }}</td>
                    <th scope="row">Colours</th>
                    <td>{{ "{:,}".format(palette.colors | length) }}</td>
                    {% if not (current_user and current_user.id != palette.user_id) %}<th scope="row">Likes</th><td>{{ "{:,}".format(palette.like_count) }}</td>{% endif %}
                </tr>
            </tbody>
        </table>
    </div>

    <div class="palette-strip">
        {% for color in palette.colors %}
            <button type="button"
                    class="palette-strip__swatch"
                    style="--color: {{ color.hex_value }}"
                    data-hex="{{ color.hex_value }}"
                    aria-label="Copy {{ color.hex_value }}">
                <span class="palette-strip__hex">{{ color.hex_value }}</span>
            </button>
        {% endfor %}
    </div>

    <div class="page-actions">
        {% if current_user and current_user.id != palette.user_id %}
            {% with liked = user_liked, small = false %}
                {% include "_like_button.jinja" %}
            {% endwith %}
            <button type="button"
                    class="btn"
                    hx-post="{{ url_for('fork_palette', id=palette.id) }}"
                    hx-swap="none">Fork palette</button>
        {% elif current_user and current_user.id == palette.user_id %}
            <a href="{{ url_for('edit_palette', id=palette.id) }}" class="btn">Edit palette</a>
        {% else %}
            <a href="{{ url_for('login') }}" class="btn">Sign in to fork</a>
        {% endif %}
        <button type="button" class="btn" id="copy-link-button">Copy link</button>
        <button type="button" class="btn" id="copy-css-button">Copy CSS</button>
        <button type="button" class="btn" id="copy-json-button">Copy JSON</button>
    </div>

    {# djlint:off #}
    <script>
        const paletteColors = {{ palette.colors | map(attribute='hex_value') | list | tojson }};
        const paletteName = {{ palette.name | tojson }};
    </script>
    {# djlint:on #}
{% endblock %}
