{% extends "base.jinja" %}

{% from "_macros.jinja" import color_count, owner %}

{% block title %}{{ palette.name }}{% endblock %}

{% block extra_headers %}
    <script src="{{ url_for('static', filename='scripts/copy-text.js') }}" defer></script>
    <script src="{{ url_for('static', filename='scripts/view.js') }}" defer></script>
{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>{{ palette.name }}</h1>
    </div>

    <p class="palette-meta">
        {{ owner(palette.owner) }}, {{ color_count(palette.colors) }},
        {% if not (current_user and current_user.id != palette.user_id) %}{{ palette.like_count }} like{{ 's' if palette.like_count != 1 }},{% endif %}
        {% if palette.is_public %}
            <span class="status status--ok">Public</span>
        {% else %}
            <span class="status">Private</span>
        {% endif %}
    </p>

    <div class="palette-strip">
        {% for color in palette.colors %}
            <button type="button"
                    class="palette-strip__swatch"
                    style="--color: {{ color.hex_value }}"
                    data-hex="{{ color.hex_value }}"
                    aria-label="Copy {{ color.hex_value }}">
                <span class="palette-strip__hex">{{ color.hex_value }}</span>
            </button>
        {% endfor %}
    </div>

    <div class="form__actions palette-actions">
        {% if current_user and current_user.id != palette.user_id %}
            <button type="button"
                    class="btn"
                    hx-post="{{ url_for('toggle_like', id=palette.id) }}"
                    hx-swap="none">{{ "Unlike" if user_liked else "Like" }} ({{ palette.like_count }})</button>
            <button type="button"
                    class="btn"
                    hx-post="{{ url_for('fork_palette', id=palette.id) }}"
                    hx-swap="none">Fork</button>
        {% elif current_user and current_user.id == palette.user_id %}
            <a href="{{ url_for('edit_palette', id=palette.id) }}" class="btn">Edit</a>
        {% else %}
            <a href="{{ url_for('login') }}" class="btn">Sign in to fork</a>
        {% endif %}
        <button type="button" class="btn" id="copyLinkButton">Copy link</button>
        <button type="button" class="btn" id="copyCssButton">Copy CSS</button>
        <button type="button" class="btn" id="copyJsonButton">Copy JSON</button>
    </div>

    {# djlint:off #}
    <script>
        const paletteColors = {{ palette.colors | map(attribute='hex_value') | list | tojson }};
        const paletteName = {{ palette.name | tojson }};
    </script>
    {# djlint:on #}
{% endblock %}
