{% extends "base.jinja" %}

{% from "_macros.jinja" import swatches, color_count %}

{% block title %}Your palettes{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Your palettes</h1>
        <div class="page-head__actions">
            <a href="{{ url_for('new') }}" class="btn">New palette</a>
        </div>
    </div>

    {% if palettes %}
        <ul class="palette-grid">
            {% for palette in palettes %}
                <li class="palette-card">
                    <a class="palette-card__preview"
                       href="{{ url_for('view_palette', id=palette.id) }}"
                       tabindex="-1"
                       aria-hidden="true">{{ swatches(palette.colors) }}</a>
                    <div class="palette-card__body">
                        <a class="palette-card__name"
                           href="{{ url_for('view_palette', id=palette.id) }}">{{ palette.name }}</a>
                        <p class="palette-card__meta">
                            {{ color_count(palette.colors) }}
                            {%- if palette.is_public %}, <span class="status status--ok">Public</span>{% else %}, <span class="status">Private</span>{% endif %}
                        </p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <div class="empty">
            <p class="empty__title">No palettes yet</p>
        </div>
    {% endif %}
{% endblock %}
