{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block body_class %}page page--topnav{% endblock %}

{% macro nav_link(endpoint, label) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% block body_content %}
    <header class="app-bar">
        <a href="{{ url_for('index') }}" class="wordmark">
            <span class="wordmark__mark">{{ icon("swatch-book") }}</span>
            <span class="wordmark__text">Huebox</span>
        </a>

        <nav class="app-bar__nav">
            {{ nav_link('explore', 'Explore') }}
            {% if current_user %}
                {{ nav_link('list', 'Palettes') }}
                {{ nav_link('new', 'New') }}
            {% endif %}
        </nav>

        <div class="app-bar__actions">
            {% if current_user %}
                <div class="menu-anchor menu-anchor--end">
                    <button type="button"
                            class="button button--ghost"
                            data-menu-toggle
                            aria-haspopup="true"
                            aria-expanded="false">
                        {% if current_user.avatar_url %}
                            <img src="{{ current_user.avatar_url }}"
                                 alt=""
                                 class="avatar avatar--sm avatar--round" />
                        {% endif %}
                        <span>{{ current_user.login }}</span>
                        {{ icon("chevron-down") }}
                    </button>
                    <ul class="menu" hidden>
                        <li>
                            <form method="post"
                                  action="{{ url_for('logout') }}"
                                  hx-post="{{ url_for('logout') }}"
                                  hx-swap="none">
                                <button type="submit">
                                    {{ icon("log-out") }} <span>Sign out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            {% else %}
                <a href="{{ url_for('login') }}" class="button">{{ icon("log-in") }} Sign in</a>
            {% endif %}
        </div>
    </header>

    <main class="page__main">
        {% block main %}{% endblock %}
    </main>
{% endblock %}
