{% extends "skeleton.jinja" %}

{% macro nav_link(endpoint, label) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">{% include "mark.svg" %}Huebox</a>
            <nav class="navbar__links" aria-label="Main">
                {{ nav_link('explore', 'Explore') }}
                {% if current_user %}
                    {{ nav_link('list', 'Your palettes') }}
                    {{ nav_link('new', 'New palette') }}
                    <span class="nav-user">
                        {% if current_user.avatar_url %}
                            <img src="{{ current_user.avatar_url }}" alt="" class="avatar" />
                        {% endif %}
                        {{ current_user.login }}
                    </span>
                    <form method="post"
                          action="{{ url_for('logout') }}"
                          hx-post="{{ url_for('logout') }}"
                          hx-swap="none">
                        <button type="submit">Sign out</button>
                    </form>
                {% else %}
                    <a href="{{ url_for('login') }}">Sign in</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="page">
        {% block content %}{% endblock %}
    </main>
{% endblock %}
